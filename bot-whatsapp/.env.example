# 1. Inteligência Artificial (OpenCode Go)
OPENCODE_API_KEY=sua_chave_aqui
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=qwen3.8-flash
OPENCODE_VISION_MODEL=deepseek-v4-flash-vision-exp

# 2. Supabase (Banco de Dados Central & Realtime)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# 3. Informações do Estabelecimento
STUDIO_NAME="Lara Varisa - Lash Designer"
STUDIO_CITY="Porto Alegre - RS"

# 4. Transcrição de Áudio (Groq Whisper)
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
